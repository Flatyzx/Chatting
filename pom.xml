<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>
    <groupId>com.example.chat</groupId>
    <artifactId>chat-desktop</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>chat-desktop</name>
    <description>Aplicativo de chat desktop com backend Spring Boot e frontend Swing</description>
    <modules>
        <module>backend</module>
        <module>frontend</module>
    </modules>
    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <flatlaf.version>3.5.4</flatlaf.version>
        <tyrus.version>2.2.0</tyrus.version>
        <maven.shade.version>3.6.0</maven.shade.version>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>
</project>
